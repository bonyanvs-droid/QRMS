# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# QRMS Backend Runtime Mode: 'local-db' on VPS with PostgreSQL, 'remote-proxy' in AI Studio
API_RUNTIME_MODE=

# Remote Development API Endpoint (Used when API_RUNTIME_MODE=remote-proxy)
# Development Remote API Basic Auth (Server-Side Only)
DEV_API_USERNAME=
DEV_API_PASSWORD=

# Server-Side HTTP Basic Auth for Remote Development API (Server-Side Only - Never exposed to client)
DEV_API_BASIC_AUTH=
DEV_API_USERNAME=
DEV_API_PASSWORD=

# PostgreSQL Database URL (Used when API_RUNTIME_MODE=local-db)
DATABASE_URL=


